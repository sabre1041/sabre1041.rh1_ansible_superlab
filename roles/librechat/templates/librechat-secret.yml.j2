---
apiVersion: v1
kind: Secret
metadata:
  name: librechat-credentials-env
  namespace: {{ librechat_namespace }}
type: Opaque
stringData:
  CREDS_KEY: {{ librechat_key32 }}
  JWT_SECRET: {{ librechat_key32 }}
  JWT_REFRESH_SECRET: {{ librechat_key32 }}

  # Required: Meilisearch master key
  # Generate using: openssl rand -hex 16
  MEILI_MASTER_KEY: {{ librechat_key16 }}

  # Optional: Custom OpenAI-compatible endpoint API key
  # Reference in librechat.yaml using ${CUSTOM_API_KEY}
  CUSTOM_MODEL_URL: {{ librechat_litemaas_url }}
  CUSTOM_MODEL_KEY: {{ librechat_litemaas_api_key }}

  # User credentials (used by user-init-job.yaml
  USER_NAME: "{{ librechat_username }}"
  USER_EMAIL: "{{ librechat_username }}@{{ librechat_email_domain }}"
  USER_PASSWORD: "{{ librechat_password }}"

  # Ansible Credentials
  ANSIBLE_MCP_TOKEN: {{ librechat_aap_token_placeholder }}
